# Configuración de Calendly API
USE_CALENDLY=true

# Tu token de acceso personal (PAT)
# IMPORTANTE: Nunca compartas este token ni lo expongas públicamente
CALENDLY_API_KEY=eyJraWQiOiIxY2UxZTEzNjE3Z....[resto del token]

# Tu User UUID de Calendly
CALENDLY_USER_UUID=a7e980da-328a-4802-ad2b-78c07c49331b

# Tu User URI completo construido con el UUID
CALENDLY_USER_URI=https://api.calendly.com/users/a7e980da-328a-4802-ad2b-78c07c49331b

# Secret para webhooks (opcional)
CALENDLY_WEBHOOK_SECRET=tu_webhook_secret_aquí
