# Dependencies
/node_modules
/vendor

# Environment / secrets
.env
.env.*
!.env.example

# Laravel runtime files
/public/storage
/public/hot
/public/build
/storage/*.key
/storage/app/*
!storage/app/.gitkeep
/storage/framework/cache/*
!storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
/storage/framework/views/*
!storage/framework/views/.gitkeep
/storage/logs/*
!storage/logs/.gitkeep
/bootstrap/cache/*
!bootstrap/cache/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / editor
.vscode/
.idea/
.DS_Store

# Local overrides (do not deploy)
*.local
*.local.php

# PHPUnit
.phpunit.result.cache
